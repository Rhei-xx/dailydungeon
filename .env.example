# ---- Daily Dungeon environment ----
# For local runs only: copy to .env (never commit it). In GitHub Actions the
# same names come from repository Secrets (the first five) and Variables.

# The bot Gmail account that emails you each turn and receives your replies.
GMAIL_USER="your.dungeon.bot@gmail.com"
# A Google App Password for that account (needs 2-Step Verification):
# https://myaccount.google.com/apppasswords  — spaces are fine.
GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"

# You — the only address whose replies are played. Must differ from GMAIL_USER.
PLAYER_EMAIL="you@example.com"

# AES-256-GCM key for the game state (32 random bytes, base64). Keep a copy in
# your password manager: without it the saved game can't be read.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STATE_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# Google Gemini — reads your free-text replies and narrates each turn.
# Optional: without it, replies are read by keyword and turns use plain text.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional model override (default: gemini-flash-latest).
GEMINI_MODEL=""

# When the daily turn goes out (24-hour local time) and in which timezone.
TIMEZONE="America/Toronto"
DELIVERY_TIME="07:00"

# Replies must carry Gmail's DMARC pass for your address's domain (anti-spoofing).
# Set to "false" only if your own mail provider doesn't pass DMARC.
REQUIRE_DMARC="true"

# Where state.json.enc lives (in CI: the game-state branch checkout).
STATE_DIR="state"
